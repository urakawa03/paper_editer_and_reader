# ビルド時に埋め込まれる任意設定。トークン類は絶対にここに置かない(.envは.gitignore済み)。

# Crossref politeプール用の連絡先メール(任意。アプリの設定画面からも指定可能)
VITE_CROSSREF_MAILTO=

# GitHub Pages(プロジェクトページ)以外にホストする場合のベースパス。既定は /paper_editer_and_reader/
# 例: ルート直下に置くなら VITE_BASE=/
VITE_BASE=

# 1にすると、PAT・GitHub設定なしで同梱サンプル(.md)を表示する開発モード
VITE_FIXTURES=
